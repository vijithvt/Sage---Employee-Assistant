# Application version, surfaced via GET /health
APP_VERSION=0.1.0

# Local LLM (Ollama) settings — no external API key required.
# The 'ollama' service in docker-compose.yml is reachable at this URL.
OLLAMA_BASE_URL=http://ollama:11434

# Any model from https://ollama.com/library can be used here — the backend
# pulls it automatically on first use if it isn't already cached.
# qwen2.5:1.5b is small, fast on CPU, and has solid instruction-following
# for its size. Try llama3.2:3b (or larger) for better answer quality if
# your machine has more RAM/CPU to spare.
OLLAMA_MODEL=qwen2.5:1.5b

# Local embedding model (sentence-transformers)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Directory where the Chroma vector store is persisted
CHROMA_PERSIST_DIR=/app/data/chroma_db

# Chunking parameters
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# Number of chunks retrieved per query
TOP_K=5

# Minimum similarity score a retrieved chunk must have to be used as context.
# Chunks below this are discarded before the LLM ever sees them, so an
# out-of-scope question gets the "not in the knowledge base" fallback
# instead of relying on the LLM to refuse on its own (small local models
# are unreliable at following "only answer from context" instructions).
MIN_SIMILARITY_SCORE=-0.5

# Max upload size for ingested documents, in MB
MAX_UPLOAD_MB=20

# Backend log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Frontend: base URL the Streamlit app uses to reach the backend API
# (docker-compose sets this automatically; only needed for local/non-Docker runs)
BACKEND_URL=http://backend:8000
